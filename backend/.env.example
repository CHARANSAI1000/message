# Local development settings for `make backend` (uvicorn on :8010). Copied to backend/.env by `make env`.
ENVIRONMENT=development
DATABASE_URL=postgresql://messenger:change-me-to-a-long-random-string@localhost:5440/messenger
PUBLIC_ORIGIN=http://localhost:8010
EXTRA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Sign in with Google: OAuth 2.0 Web client ID from Google Cloud Console ---
GOOGLE_CLIENT_ID=
# --- Email for one-time codes: EMAIL_PROVIDER=smtp (Gmail etc.) or brevo (HTTPS API; needed on Render free)
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# SMTP settings (leave SMTP_HOST empty in dev to print codes to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
