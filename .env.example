# Copy to .env (`make env` does it). Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Host ports (change if they clash with other projects)
DB_PORT=5440
APP_PORT=8080

# --- Sign in with Google: OAuth 2.0 Web client ID from Google Cloud Console ---
GOOGLE_CLIENT_ID=
# --- Email for one-time codes: EMAIL_PROVIDER=smtp (Gmail etc.) or brevo (HTTPS API; needed on Render free)
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# SMTP settings (leave SMTP_HOST empty in dev to print codes to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com

# --- Web Push: run `make vapid` and paste the two lines ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# --- Calls: optional TURN relay (or CLOUDFLARE_TURN_KEY_ID + CLOUDFLARE_TURN_API_TOKEN) ---
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# --- Native app push (Firebase): service-account JSON on one line, or base64 of the file ---
FCM_SERVICE_ACCOUNT_JSON=
